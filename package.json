{
  "name": "netsapiens-mcp",
  "version": "3.0.0",
  "description": "MCP server for the NetSapiens API: per-user sign-in, role-aware tools, version-aware availability",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./lib": {
      "types": "./build/lib.d.ts",
      "default": "./build/lib.js"
    },
    "./testing/store-conformance": {
      "types": "./build/store/conformance.d.ts",
      "default": "./build/store/conformance.js"
    }
  },
  "bin": {
    "netsapiens-mcp": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "watch": "tsx watch src/index.ts",
    "clean": "rimraf build",
    "generate:governance": "tsx scripts/generate-governance.ts",
    "specs:fetch": "tsx scripts/fetch-specs.ts",
    "specs:probe": "tsx scripts/probe-routes.ts",
    "specs:validate": "tsx scripts/validate-observations.ts",
    "generate": "tsx scripts/generate-tools.ts && tsx scripts/generate-v1-tools.ts && tsx scripts/generate-governance.ts",
    "prebuild": "npm run clean && npm run generate",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "netsapiens",
    "voip",
    "api",
    "integration"
  ],
  "author": "OITVOIP",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.20.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.2.2",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@google-cloud/firestore": "^7.11.0 || ^8.0.0 || ^9.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@google-cloud/firestore": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/supertest": "^7.2.0",
    "ajv": "^8.20.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoneware/netsapiens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/phoneware/netsapiens-mcp/issues"
  },
  "homepage": "https://github.com/phoneware/netsapiens-mcp#readme"
}
