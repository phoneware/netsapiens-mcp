{
  "name": "netsapiens-mcp",
  "version": "2.0.0",
  "description": "NetSapiens MCP Server for NetSapiens Platform Integration",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./lib": {
      "types": "./build/lib.d.ts",
      "default": "./build/lib.js"
    }
  },
  "bin": {
    "netsapiens-mcp": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "watch": "tsx watch src/index.ts",
    "clean": "rimraf build",
    "generate": "tsx scripts/generate-tools.ts && tsx scripts/generate-v1-tools.ts",
    "prebuild": "npm run clean && npm run generate",
    "prepack": "npm run build",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');for(const d of ['dist/esm','dist/cjs']){const p=path.join('node_modules/@modelcontextprotocol/sdk',d);if(fs.existsSync(p)&&!fs.existsSync(path.join(p,'index.js'))){fs.writeFileSync(path.join(p,'index.js'),d.includes('esm')?'export * from \\\"./server/index.js\\\";\\nexport * from \\\"./types.js\\\";\\n':'module.exports=Object.assign({},require(\\\"./server/index.js\\\"),require(\\\"./types.js\\\"));\\n');}}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "netsapiens",
    "voip",
    "oitvoip",
    "api",
    "integration"
  ],
  "author": "OITVOIP",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.6.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "rimraf": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phoneware/netsapiens-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/phoneware/netsapiens-mcp/issues"
  },
  "homepage": "https://github.com/phoneware/netsapiens-mcp#readme"
}
