# =============================================================================
# NetSapiens MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Required: NetSapiens API ---
# Base URL of your NetSapiens API instance
NETSAPIENS_API_URL=https://edge.phoneware.cloud

# --- Required for HTTP transport: operator-level NS OAuth credentials ---
# These are used server-side to authenticate users via the browser login page.
# User credentials never pass through the MCP transport or LLM.
NETSAPIENS_OAUTH_CLIENT_ID=
NETSAPIENS_OAUTH_CLIENT_SECRET=

# --- Required for production: public base URL ---
# The externally reachable URL of this MCP server.
# Used for OAuth metadata discovery and redirect URIs.
# Must match what MCP clients use to connect.
MCP_BASE_URL=https://mcp.yourdomain.com

# --- Optional: transport and networking ---
# MCP_TRANSPORT=http          # http (default in Docker) or stdio
# MCP_PORT=3000               # Port to listen on (default: 3000)
# MCP_HOST=0.0.0.0            # Bind address (default: 0.0.0.0)

# --- Optional: transport mode ---
# MCP_STATELESS=true          # Run without server-side sessions (default).
#                             # Each request builds its own server + transport
#                             # from the bearer, so any instance can serve any
#                             # request. Set false to keep sessions, which are
#                             # required for elicitation prompts and
#                             # tools/list_changed notifications.
#                             # When MCP_CONFIRM_DESTRUCTIVE=true and this is
#                             # unset, sessions are kept automatically.
# MCP_TOOLS_PAGE_SIZE=250     # Tools per tools/list page (default: 250)

# --- Optional: server identity shown in MCP clients ---
# MCP_SERVER_TITLE=NetSapiens # Display name on the initialize response
# MCP_WEBSITE_URL=https://... # Link clients can show alongside the server
# MCP_ICON_URL=https://...    # Icon, also proxied at /favicon.png

# --- Optional: token storage ---
# MCP_TOKEN_STORE_PATH=       # File-backed token store path
#                             # (default: ~/.netsapiens-mcp/http-tokens.json)

# --- Optional: write semantics ---
# MCP_SYNCHRONOUS_WRITES=true # Send synchronous=yes on writes that accept it
#                             # (default). NS otherwise returns 202 before the
#                             # write is readable, which breaks create-then-read
#                             # flows. Set false to use the API's own default.

# --- Optional: CORS ---
# MCP_CORS_ORIGIN=*           # Allowed origins (default: * — restrict in production)

# --- Optional: logging ---
# LOG_LEVEL=info              # debug, info, warn, error (default: info)
# DEBUG=false                 # Enable debug logging (default: false)
