# =============================================================================
# NetSapiens MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- NetSapiens API & Platforms (§3.1) ---
# Base URL of your NetSapiens API instance (required for both http and stdio)
NETSAPIENS_API_URL=https://netsapiens.example.com

# Optional JSON object of allowed platforms for multi-platform token sign-in (http only).
# Format: {"<id>": "<url>" | {"apiUrl": "<url>", "label": "<text>"}}
# NETSAPIENS_PLATFORMS={"default":"https://netsapiens.example.com"}

# --- HTTP Transport Authentication Credentials (§3.1) ---
# Required for HTTP transport: NetSapiens OAuth client credentials.
# Used server-side to authenticate users via the browser login page.
# User credentials never pass through the MCP transport or LLM.
NETSAPIENS_OAUTH_CLIENT_ID=
NETSAPIENS_OAUTH_CLIENT_SECRET=

# --- HTTP Persistence and Store Configuration (§A3.1) ---
# Store backend: sqlite (default), firestore, or memory
MCP_PERSISTENCE=sqlite

# Store namespace: collection prefix for Firestore or database filename for SQLite.
# Must match ^[a-z][a-z0-9_]{0,30}$ (default: mcp, or readonly_mcp when MCP_READ_ONLY=true)
# MCP_STORE_NAMESPACE=mcp

# Custom absolute path for SQLite database file (SQLite backend only).
# Default: ~/.netsapiens-mcp/<namespace>.sqlite
# MCP_STORE_PATH=/home/nodejs/.netsapiens-mcp/mcp.sqlite

# Session and store encryption secret (required for HTTP transport).
# Must be at least 32 characters. Signs/seals session state and derives store encryption key.
# Changing this secret invalidates all existing sessions.
MCP_SESSION_SECRET=

# Google Cloud project ID (required when MCP_PERSISTENCE=firestore).
# GOOGLE_CLOUD_PROJECT=

# Note on removed variables:
# MCP_TOKEN_STORE_PATH was removed in 3.0.0; use MCP_STORE_PATH.
# FIRESTORE_AUTH_CODES_COLLECTION and FIRESTORE_RESUME_TOKENS_COLLECTION were removed in 3.0.0; use MCP_STORE_NAMESPACE.
# MCP_PLATFORMS was removed in 3.0.0; use NETSAPIENS_PLATFORMS.

# --- HTTP Networking and Base URL (§3.1) ---
# MCP_TRANSPORT=http          # http (default in Docker) or stdio
# MCP_PORT=3000               # Port to listen on (default: 3000)
# MCP_HOST=0.0.0.0            # Bind address (default: 0.0.0.0)
# Public base URL of this MCP server (required in production for OAuth metadata discovery and redirects)
MCP_BASE_URL=https://mcp.example.com
# MCP_CORS_ORIGIN=*           # Allowed CORS origins (default: * — restrict in production)

# --- HTTP Session Mode and Token Lifetime (§3.1, §A3.1) ---
# MCP_STATELESS=true          # Run without server-side sessions (default: true).
#                             # Set false to keep sessions for elicitation prompts.
# MCP_TOKEN_LIFETIME_HOURS=168 # Lifetime of issued bearer tokens in hours (default: 168 / 7 days)
# MCP_TOOLS_PAGE_SIZE=250     # Tools per tools/list page (default: 250)

# --- Server Identity and Branding (§3.1) ---
# MCP_SERVER_TITLE=NetSapiens # Display name on initialize response
# MCP_WEBSITE_URL=https://example.com # Link displayed alongside server
# MCP_ICON_URL=https://example.com/icon.png # Server icon (proxied at /favicon.png)
# MCP_LOGIN_HEADER=NetSapiens # Custom login page heading
# MCP_LOGIN_LOGO_URL=https://example.com/logo.png # Custom login page logo

# --- Stdio Transport Authentication (§3.1) ---
# Required for stdio mode: provide either a static token OR the 4 OAuth credentials.
# NETSAPIENS_API_TOKEN=
# NETSAPIENS_OAUTH_USERNAME=
# NETSAPIENS_OAUTH_PASSWORD=

# --- Tool Filtering, Governance, and Permissions (§3.1) ---
# MCP_READ_ONLY=false          # When true, disables all mutating tools and namespaces
# MCP_TOOL_MODE=               # Select tool catalog
# MCP_DISABLED_TOOLS=          # Comma-separated list/patterns of tools to disable
# MCP_DISABLED_ACTIONS=        # Comma-separated list of actions to disable
# MCP_DISABLE_DESTRUCTIVE=false # Disable destructive tools
# MCP_DISABLE_ROLE_FILTER=false # Disable role-based tool filtering
# MCP_CONFIRM_DESTRUCTIVE=false # Request user confirmation for destructive actions
# MCP_CONFIRM_FALLBACK=        # Fallback policy when confirmation is rejected
# MCP_DISABLE_PROMOTION=false  # Disable automatic tool promotion
# MCP_PROMOTE_THRESHOLD=       # Usage threshold for tool promotion
# MCP_PROMOTE_WINDOW_DAYS=     # Time window for promotion threshold

# --- Upstream Write Semantics & Runtime Detection (§3.1, §V2) ---
# MCP_SYNCHRONOUS_WRITES=true # Send synchronous=yes on writes that accept it (default: true)
# NETSAPIENS_VERSION_TTL_SECONDS=3600 # Version discovery cache TTL in seconds (default: 3600)

# --- Logging & Debugging ---
# LOG_LEVEL=info              # debug, info, warn, error (default: info)
# DEBUG=false                 # Enable debug logging (default: false)
